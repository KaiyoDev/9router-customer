# 9Router ARM64 — Production Containerfile
#
# Multi-stage build optimized for ARM64 TV Box (~2GB RAM).
# Uses Node.js 22 Alpine (ARM64) with built-in node:sqlite (no native deps).
# Podman-compatible — no Docker-specific features.
#
# Build (rootless Podman on TV Box):
#   podman build --cgroup-manager=cgroupfs \
#     --platform linux/arm64 \
#     -t localhost/9router:custom-arm64 \
#     -f production/Containerfile .
#
# The .excludes file (production/.excludes) is applied by
# scripts/sync-upstream.sh BEFORE this Containerfile runs,
# so the build context is already production-clean.

# ── Stage 1: Builder ───────────────────────────────────────
# Using node:22-slim (Debian/glibc) instead of Alpine/musl.
# Next.js SWC binary (lightningcss) only ships glibc builds,
# so Alpine would fail with "Cannot find module lightningcss.*.musl.node".
FROM node:22-slim AS builder

WORKDIR /build

# NOTE: No build tools needed.
# - node:sqlite is built into Node.js 22 (native, zero install)
# - sql.js is pure JS (no compilation)
# - better-sqlite3 is optional; removed to keep image small

# Copy manifests first (layer caching)
COPY package.json ./

# Install ALL dependencies (build needs @tailwindcss/postcss, postcss, tailwindcss
# which are in devDependencies).  eslint is also installed but never copied
# into the runner stage, so it adds zero runtime overhead.
# --ignore-scripts prevents native addon compilation (better-sqlite3).
# Using npm install instead of npm ci: package-lock.json is gitignored
# in this repo so it won't be available in the build context.
RUN npm install --ignore-scripts --omit=optional \
    && npm cache clean --force \
    && rm -rf /root/.npm /tmp/* /var/tmp/*

# ── Pre-install SWC binary for Linux ARM64 glibc ──────────────
# Next.js standalone output needs this binary at runtime.
# Without it, lightningcss fails with "Cannot find module ...musl.node"
# even when building on Debian/glibc.  We install the GNU variant
# explicitly so Next.js doesn't try to auto-download the wrong one.
RUN npm install --no-save --ignore-scripts @next/swc-linux-arm64-gnu@$(node -e "console.log(require('./node_modules/next/package.json').version)") 2>/dev/null || \
    npm install --no-save --ignore-scripts @next/swc-linux-arm64-gnu@16.3.2

# Copy application source (tests/, cli/ already excluded by .excludes)
COPY . .

# Disable telemetry, enable standalone output
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build Next.js standalone output
RUN npm run build

# ── Stage 2: Runner (minimal ARM64 image) ─────────────────
# Must match builder base for SWC/lightningcss binary compatibility.
FROM node:22-slim AS runner

WORKDIR /app

# Create non-root user for container security
# Use || true to skip if group/user already exists (e.g. GID 1000 in base image)
RUN (getent group nodejs || groupadd -g 1000 nodejs) \
    && (id -u nodejs &>/dev/null || useradd -u 1000 -g nodejs -d /app -s /bin/sh nodejs)

# ── Runtime environment ────────────────────────────────────
ENV NODE_ENV=production \
    PORT=20130 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1 \
    DATA_DIR=/app/data \
    ENABLE_REQUEST_LOGS=false \
    OBSERVABILITY_ENABLED=false \
    NODE_OPTIONS="--max-old-space-size=512 --no-warnings"

# ── Copy standalone build from builder ────────────────────
COPY --from=builder /build/.next/standalone/ ./

# ── Copy packages excluded from standalone tracing ────────
# serverExternalPackages in next.config.mjs lists these:
# Note: better-sqlite3 removed — Node 22 has built-in node:sqlite.
COPY --from=builder /build/node_modules/sql.js        ./node_modules/sql.js
COPY --from=builder /build/node_modules/open          ./node_modules/open
COPY --from=builder /build/node_modules/next          ./node_modules/next
# SWC binary (lightningcss) — must match the glibc variant for ARM64
COPY --from=builder /build/node_modules/@next/swc-linux-arm64-gnu \
                    ./node_modules/@next/swc-linux-arm64-gnu

# ── Copy custom server wrapper (IP sanitization) ─────────
COPY --from=builder /build/custom-server.js ./custom-server.js

# ── Copy public assets & static ───────────────────────────
COPY --from=builder /build/public   ./public
COPY --from=builder /build/.next/static ./.next/static

# ── MITM source (needed for proxy mode) ──────────────────
COPY --from=builder /build/src/mitm ./src/mitm

# ── Create data dirs with correct permissions ─────────────
RUN mkdir -p /app/data /app/logs \
    && chown -R nodejs:nodejs /app \
    && chmod -R 755 /app

# ── Switch to non-root ────────────────────────────────────
USER nodejs

# ── Healthcheck (lightweight HTTP, no curl needed) ────────
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=20s \
  CMD node -e "const http=require('http');const opts={hostname:'127.0.0.1',port:20130,path:'/api/auth/status',timeout:5000};const req=http.request(opts,res=>{process.exit(res.statusCode===200?0:1)});req.on('error',()=>process.exit(1));req.end();"

EXPOSE 20130

# ── Entry point ───────────────────────────────────────────
RUN printf '#!/bin/sh\nset -e\nmkdir -p /app/data /app/logs\nexec node custom-server.js\n' > /app/entrypoint.sh \
    && chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
