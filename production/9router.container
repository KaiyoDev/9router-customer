# 9Router Podman Quadlet — ARM64 TV Box Deployment
#
# Install location: ~/.config/containers/systemd/9router.container
#
# This file is GENERATED by build-and-deploy.sh and should NOT be
# edited by hand. The Image= tag is updated automatically on each deploy.
#
# To reset: remove this file and run build-and-deploy.sh again.

[Unit]
Description=9Router AI Gateway (ARM64 TV Box)
Documentation=https://github.com/decolua/9router
After=network-online.target
Wants=network-online.target

[Container]
# Image — AUTO-UPDATED by build-and-deploy.sh
# Format: localhost/9router:<git-sha>-<date>
Image=localhost/9router:current

ContainerName=9router

# Port binding
PublishPort=20130:20130

# Restart on crash or host reboot (requires linger enabled)
RestartPolicy=always
RestartSec=10

# Resource limits — hard cap to protect 2GB TV Box
MemoryMax=1800M
MemoryHigh=1500M

# Environment (matched to custom/config/.env.production)
Env=NODE_ENV=production
Env=PORT=20130
Env=HOSTNAME=0.0.0.0
Env=LOW_MEMORY_MODE=1
Env=NODE_OPTIONS=--max-old-space-size=512 --no-warnings
Env=ENABLE_REQUEST_LOGS=false
Env=OBSERVABILITY_ENABLED=false
Env=DATA_DIR=/app/data

# Persistent volumes
# Data: SQLite database
Volume=/home/kaiyo/.local/share/9router-data:/app/data:rw,Z
# Logs: ~/.9router usage.json + log.txt
Volume=/home/kaiyo/.local/share/9router-logs:/home/nodejs/.9router:rw,Z

# Security: isolated network, no privileged, no host namespaces
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/app/data /home/nodejs/.9router
NoNewPrivileges=true
RestrictSUIDSGID=true

# Temporary filesystem isolation
TemporaryFileSystem=/tmp
TempSpace=256M

[Service]
# Graceful shutdown: 30s for in-flight requests to complete
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
IgnoreSIGPIPE=no
GuessMainPID=no

# Log to journald
LogForwarding=yes

[Install]
# Auto-start when user session is active (requires linger)
WantedBy=default.target session.target
